# Copy to .env and fill in with your own project values.
# Lovable Cloud injects these automatically; they are only needed for
# self-hosted deploys (Vercel / Netlify / GitHub Actions).

# --- Client (safe to expose, publishable) ---
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Legacy alias, still accepted by older Supabase projects:
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- Server only (never expose to the browser) ---
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# --- Admin CMS gate ---
ADMIN_PASSCODE="change-me"
ADMIN_SESSION_SECRET="at-least-32-random-characters-long-string"
